# ============================================
# LeiaPix AI - Celery Worker: 图像增强 (gpu_enhance 队列)
# ============================================
# 独立依赖: PyTorch CUDA + Real-ESRGAN (basicsr + realesrgan)
# 并发上限: 1 (超分辨率显存占用极大)
# 构建: docker build -f deploy/docker/Dockerfile.worker-enhance -t leiapix-worker-enhance .
# ============================================

FROM pytorch/pytorch:2.4.0-cuda12.1-cudnn9-devel AS enhance-base

# 系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev curl git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ---- 安装后端核心依赖 ----
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple

# ---- 安装 Real-ESRGAN 专用依赖 ----
# 注意: basicsr/realesrgan 可能与 depth 的 timm 版本冲突
# 所以放在独立镜像中隔离
RUN pip install --no-cache-dir \
    basicsr>=1.4.2 \
    realesrgan>=0.3.0 \
    facexlib>=0.3.0 \
    gfpgan>=1.3.8 \
    opencv-python-headless>=4.9.0 \
    -i https://pypi.tuna.tsinghua.edu.cn/simple

# 复制后端代码
COPY backend/ /app/

# 复制 AI 模型代码
COPY ai-models/ /app/ai-models/

# 模型权重目录 (运行时通过 volume 挂载)
VOLUME ["/app/ai-models/enhance/real_esrgan/weights"]

# GPU 增强 Worker 启动命令
# --concurrency=1: 超分辨率显存占用极大, 严格单并发
# -Q gpu_enhance: 仅消费 gpu_enhance 队列
# --max-tasks-per-child=5: 每 5 个任务重启进程, 防止显存泄漏
CMD ["celery", "-A", "app.core.celery_app:celery_app", "worker", \
     "--loglevel=info", \
     "--concurrency=1", \
     "-Q", "gpu_enhance", \
     "--max-tasks-per-child=5", \
     "--without-heartbeat", \
     "-n", "worker-enhance@%h"]
