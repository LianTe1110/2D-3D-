# ============================================
# LeiaPix AI - Celery Worker: 深度估计 (gpu_depth 队列)
# ============================================
# 独立依赖: PyTorch CUDA + Depth Anything V2
# 并发上限: 2 (24G 显存) / 1 (12G 显存)
# 构建: docker build -f deploy/docker/Dockerfile.worker-depth -t leiapix-worker-depth .
# ============================================

FROM pytorch/pytorch:2.4.0-cuda12.4-cudnn9-devel AS depth-base

# 系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev curl git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ---- 安装后端核心依赖 (不含 AI 模型) ----
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple

# ---- 安装 Depth Anything V2 专用依赖 ----
# 注意: PyTorch 已由基础镜像提供, 不重复安装
RUN pip install --no-cache-dir \
    timm>=0.9.12 \
    opencv-python-headless>=4.9.0 \
    -i https://pypi.tuna.tsinghua.edu.cn/simple

# 复制后端代码
COPY backend/ /app/

# 复制 AI 模型代码
COPY ai-models/ /app/ai-models/

# 模型权重目录 (运行时通过 volume 挂载)
VOLUME ["/app/ai-models/depth/depth_anything_v2/weights"]

# GPU 深度估计 Worker 启动命令
# --concurrency=2: 24G 显存最多 2 并发 (12G 显存改为 1)
# -Q gpu_depth: 仅消费 gpu_depth 队列
# --max-tasks-per-child=10: 每 10 个任务重启进程, 防止显存泄漏
CMD ["celery", "-A", "app.core.celery_app:celery_app", "worker", \
     "--loglevel=info", \
     "--concurrency=2", \
     "-Q", "gpu_depth", \
     "--max-tasks-per-child=10", \
     "--without-heartbeat", \
     "-n", "worker-depth@%h"]
