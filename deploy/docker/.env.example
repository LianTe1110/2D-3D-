# ============================================
# LeiaPix AI - 环境变量配置模板
# ============================================
# 复制此文件为 .env 并填入实际值:
#   cp .env.example .env
# ============================================

# --------------- PostgreSQL ---------------
POSTGRES_PORT=5432
POSTGRES_DB=leiapix
POSTGRES_USER=leiapix
POSTGRES_PASSWORD=leiapix

# --------------- Redis ---------------
REDIS_PORT=6379

# --------------- MinIO ---------------
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=leiapix
MINIO_ROOT_PASSWORD=leiapix123

# --------------- MongoDB ---------------
MONGO_PORT=27017
MONGO_USER=leiapix
MONGO_PASSWORD=leiapix123

# --------------- 应用配置 ---------------
DATABASE_URL=postgresql://leiapix:leiapix@localhost:5432/leiapix
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=leiapix
MINIO_SECRET_KEY=leiapix123
MONGO_URI=mongodb://leiapix:leiapix123@localhost:27017
JWT_SECRET=dev-secret
GPU_ENABLED=true
MODEL_PATH=./ai-models
MAX_UPLOAD_SIZE_MB=20
CORS_ORIGINS=http://localhost:3000

# --------------- GPU 显存保护 ---------------
# 深度估计 Worker 最大显存 (MB)
GPU_DEPTH_MAX_MEMORY_MB=8192
# 图像增强 Worker 最大显存 (MB)
GPU_ENHANCE_MAX_MEMORY_MB=10240

# --------------- 前端 URL (导出 Worker 使用) ---------------
FRONTEND_URL=http://localhost:5173
